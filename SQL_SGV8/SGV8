/* View: PESQUISAPEDIDOSPORPRODVEND, Owner: SYSDBA */

CREATE VIEW "PESQUISAPEDIDOSPORPRODVEND" (
  "CODIGO", 
  "NUMERO", 
  "OC", 
  "DATA", 
  "DATAPROGRAMA", 
  "CODCLIENTE", 
  "CODFABRICA", 
  "CODPAG", 
  "CODTRANSPORTE", 
  "CODVENDEDOR", 
  "FRETE", 
  "OBS", 
  "TOTAL", 
  "TOTAL_CIPI", 
  "FATURADO", 
  "DESCONTO1", 
  "DESCONTO2", 
  "DESCONTO3", 
  "DESCONTO4", 
  "DESCONTO5", 
  "DESCONTO6", 
  "COIFICIENTE", 
  "TIPO", 
  "CODPEDIDO", 
  "CODPRODUTO", 
  "CODIGO1"
) AS

select 
    pedido.codigo,
    pedido.numero,
    pedido.oc,
    pedido.data,
    pedido.dataprograma,
    pedido.codcliente,
    pedido.codfabrica,
    pedido.codpag,
    pedido.codtransporte,
    pedido.codvendedor,
    pedido.frete,
    pedido.obs,
    pedido.total,
    pedido.total_cipi,
    pedido.faturado,
    pedido.desconto1,
    pedido.desconto2,
    pedido.desconto3,
    pedido.desconto4,
    pedido.desconto5,
    pedido.desconto6,
    pedido.coificiente,
    pedido.tipo,
    itenspedido.codpedido,
    itenspedido.codproduto,
    produtos.codigo
from produtos
   inner join itenspedido on (produtos.codigo = itenspedido.codproduto)
   inner join pedido on (itenspedido.codpedido = pedido.codigo)
where 
   (
      (itenspedido.codproduto = produtos.codigo)
   and 
      (pedido.tipo = pedido.tipo)
   )
;

/* View: SOMA_PROD_VEND_ENTRE_DATAS, Owner: SYSDBA */

CREATE VIEW "SOMA_PROD_VEND_ENTRE_DATAS" (
  "REFERENCIA", 
  "SUM_OF_QUANT"
) AS

 select 
    produtos.referencia,
    sum( itenspedido.quant ) sum_of_quant
from pedido
   inner join itenspedido on (pedido.codigo = itenspedido.codpedido)
   inner join produtos on (itenspedido.codproduto = produtos.codigo)
where 
   (
      (pedido.data between pedido.data and pedido.data)
   )
group by produtos.referencia
order by 2 desc
;

/* View: SOMAVENDPROD_DE_FABRICA, Owner: SYSDBA */

CREATE VIEW "SOMAVENDPROD_DE_FABRICA" (
  "REFERENCIA", 
  "SUM_OF_QUANT"
) AS

   select 
    produtos.referencia,
    sum( itenspedido.quant ) sum_of_quant
from itenspedido
   inner join pedido on (itenspedido.codpedido = pedido.codigo)
   inner join produtos on (itenspedido.codproduto = produtos.codigo)
   inner join fabrica on (produtos.codfabrica = fabrica.codigo)
where 
   (
      (pedido.data between pedido.data and pedido.data)
   and 
      (pedido.codfabrica = fabrica.codigo)
   )
group by produtos.referencia
order by 2 desc
;

/* View: SOMAVENDPRODFAB_CLIENTE, Owner: SYSDBA */

CREATE VIEW "SOMAVENDPRODFAB_CLIENTE" (
  "REFERENCIA", 
  "SUM_OF_QUANT"
) AS

select 
    produtos.referencia,
    sum( itenspedido.quant ) sum_of_quant
from fabrica
   inner join pedido on (fabrica.codigo = pedido.codfabrica)
   inner join itenspedido on (pedido.codigo = itenspedido.codpedido)
   inner join produtos on (itenspedido.codproduto = produtos.codigo)
   inner join clientes on (pedido.codcliente = clientes.codigo)
where 
   (
      (pedido.data between pedido.data and pedido.data)
   and 
      (pedido.codfabrica = fabrica.codigo)
   and 
      (pedido.codcliente = clientes.codigo)
   )
group by produtos.referencia
order by 2 desc
;
