{DONE -oRicardo -cTela de pesquisa : Construir tela que informa "Clientes que estão a X dias sem compra"

select
    c.codigo,
    c.nomefantasia,
    c.razaosocial
from clientes c
where  c.codigo not in (select p.codcliente
                     from pedido p
                     where p.data  between '01/01/2020' and '07/07/2021'
                     group by p.codcliente)}
